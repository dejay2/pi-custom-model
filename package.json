{
  "name": "pi-custom-model",
  "version": "1.3.1",
  "type": "module",
  "description": "pi extension: easily add custom models with custom endpoints and API keys (/add-model wizard)",
  "license": "MIT",
  "keywords": ["pi-package"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": ["./extensions/custom-model/index.ts"]
  },
  "scripts": {
    "test": "node extensions/custom-model/test-store.ts && node extensions/custom-model/test-discover.ts && node extensions/custom-model/test-multiselect.ts"
  }
}
